static int source_resources_check(LARGE_INTEGER frequency){
 TaxiSourceResourceSnapshot *s=malloc(sizeof *s);if(!s)fail("Resource snapshot allocation failed.");
 char asset_path[MAX_PATH];source_restart_path(asset_path,"driving.ctr");TaxiRuntimeAsset expected_runtime;if(taxi_runtime_asset_load(&expected_runtime,asset_path))fail("Expected driving resource unavailable.");
 source_restart_bind(frequency);memset(source_restart.npcs,165,sizeof source_restart.npcs); /* Explicit retained-slot diagnostic fixture. */
 source_resources_snapshot(s);unsigned generation=ordinary_resource_generation;
 if(load_ordinary_resources(NULL)!=-1||load_ordinary_resources("startup")!=-1||load_ordinary_resources("../city1")!=-1)fail("Invalid resource scene accepted.");
 source_resources_unchanged(s);if(ordinary_resource_generation!=generation)fail("Rejected resource request changed generation.");
 source_viewer.owner.phase=TAXI_FRAME_WAITING;source_resources_snapshot(s);
 if(load_ordinary_resources("city1")!=-1)fail("Active ordinary publication allowed resource replacement.");source_resources_unchanged(s);source_viewer.owner.phase=TAXI_FRAME_IDLE;
 source_restart.mode=2;source_resources_snapshot(s);if(load_ordinary_resources("city1")!=-1)fail("Active restart allowed resource replacement.");source_resources_unchanged(s);source_restart.mode=0;
 source_restart.loading.phase=TAXI_LOADING_PREPARED;source_resources_snapshot(s);if(load_ordinary_resources("city1")!=-1)fail("Prepared loading child allowed resource replacement.");source_resources_unchanged(s);source_restart.loading.phase=TAXI_LOADING_IDLE;
 puts("PASS RESOURCE ADMISSION GUARDS: invalid names, ordinary publication, restart and prepared loading rejected before resource changes.");
 for(unsigned driver=0;driver<4;driver++)for(unsigned city=0;city<2;city++){
  native_game_driver=driver;native_settings[4]=(uint8_t)city;memset(&runtime,165,sizeof runtime);source_resources_snapshot(s);generation=ordinary_resource_generation;
  if(load_ordinary_resources(city?"city2":"city1"))fail("Ordinary resource-only load failed.");
  source_resources_unchanged(s);
  if(memcmp(&runtime.trig,&expected_runtime.trig,sizeof runtime.trig)||memcmp(runtime.templates,expected_runtime.templates,sizeof runtime.templates)||memcmp(runtime.starts,expected_runtime.starts,sizeof runtime.starts))fail("Resource-only loader did not refresh immutable runtime data.");
  if(!ordinary_resources_pending||ordinary_resource_generation!=generation+1||source_restart.initialized||source_restart.packets||source_restart.queue_packets||source_restart.normal||source_restart.special)fail("Resource publication/invalidation boundary invalid.");
  if(scene_index!=(int)city||world.nv!=vertex_count||world.np!=face_count||world.nm!=material_count||native_scene_registration.textures!=native_indexed_scene.count||passenger_asset.count>128)fail("Ordinary source resources disagree with renderer metadata.");
  source_restart_bind(frequency);
  if(!source_restart.initialized||source_restart.panel_engine.world!=&world||source_restart.panel_engine.textures!=&native_indexed_scene||source_restart.panel_engine.capacity!=(size_t)world.np+world.special_count+1||source_restart.pool.actors!=source_restart.npcs)fail("Resource factory retained wrong world/capacity/slots.");
  printf("PASS ORDINARY RESOURCES: city%u driver%u generation%u polygons%u passengers%u capacity%zu; game/clock/audio/RNG retained, native initialization required.\n",city+1,driver,ordinary_resource_generation,world.np,passenger_asset.count,source_restart.panel_engine.capacity);fflush(stdout);
 }
 free(s);puts("PASS SOURCE RESOURCE CHECK:8city/driver swaps, old gameplay owner snapshots unchanged, buffers rebound; no gameplay advanced after swap.");return 0;
}
